# MLC LocalEmbed Configuration Template
# This file is located at /etc/localembed/config.yaml

server:
  port: 9142
  log_level: "info"
  # Maximum number of concurrent embedding requests
  max_concurrency: 4
  lru_cache_size: 10

storage:
  # Where models are stored. The systemd service runs with this as its data dir.
  cache_dir: "/var/lib/localembed/models"
  # The default model is bundled in the RPM, so the service runs fully offline.
  # Set this to true if you want missing (non-bundled) models to be downloaded
  # from HuggingFace on first use.
  allow_offline_download: false

onnx:
  # Threads used for internal ONNX operations
  intra_op_num_threads: 4
  inter_op_num_threads: 4
  use_gpu: false # Set to true to enable GPU acceleration

models:
  # The model to use if no specific model is requested in the API call.
  # multilingual-e5-small resolves to the HuggingFace repo qdrant/multilingual-e5-small,
  # so it works both offline (once cached) and on first use (auto-download).
  default: "multilingual-e5-small"

  # List of available models. To add a model offline, copy its files to
  # /var/lib/localembed/models/<name>/ (or let the preloader fetch them).
  available:
    - name: "multilingual-e5-small"
      aliases: ["qllama/multilingual-e5-small", "tukia/text-embedding-multilingual-e5-small"]
      dim: 384
      description: "Fast multilingual embedding (qdrant/multilingual-e5-small)"
      query_prefix: "query: "
      document_prefix: "passage: "
      enabled: true

    - name: "all-minilm"
      source_repo: "Xenova/all-MiniLM-L6-v2"
      model_file: "model.onnx"
      pooling: "mean"
      dim: 384
      description: "Standard symmetric embedding for comparison"
      enabled: false
