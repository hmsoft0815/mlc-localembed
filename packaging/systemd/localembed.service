[Unit]
Description=MLC LocalEmbed - Fast Local Text Embedding Service
After=network.target

[Service]
Type=simple
User=localembed
Group=localembed
WorkingDirectory=/var/lib/localembed
Environment=ONNX_PATH=/usr/lib64/localembed/libonnxruntime.so
ExecStart=/usr/bin/localembed-server -config /etc/localembed/config.yaml
Restart=on-failure
StandardOutput=append:/var/log/localembed/server.log
StandardError=append:/var/log/localembed/server.log

[Install]
WantedBy=multi-user.target
