# Install-test for the prebuilt RPM on a modern RPM target (glibc >= 2.39).
# Build the package first on the host (`task rpm`), then this image installs it
# and verifies the file layout, service unit, and that the server boots.
#
#   task rpm            # produces build/rpmbuild/RPMS/x86_64/localembed-*.rpm
#   task rpm-test       # builds this image (which installs & verifies the RPM)
FROM fedora:41

RUN dnf install -y --setopt=install_weak_deps=False \
    curl jq procps-ng man-db systemd \
    && dnf clean all

# Copy the RPM built on the host into the image.
COPY build/rpmbuild/RPMS/x86_64/localembed-*.x86_64.rpm /tmp/

# 1. Install the package. Clear tsflags so documentation (man pages) is
#    installed too — the fedora container image defaults to tsflags=nodocs,
#    which would otherwise skip them and misrepresent a normal install.
RUN echo "--- Installing RPM ---" && \
    dnf install -y --setopt=tsflags= /tmp/localembed-*.x86_64.rpm

# 2. Verify the installed file structure (note: server binary is mlcembedder).
RUN echo "--- Verifying Files ---" && \
    test -x /usr/bin/mlcembedder && \
    test -x /usr/bin/localembed-cli && \
    test -x /usr/bin/localembed-preloader && \
    test -f /usr/lib64/localembed/libonnxruntime.so && \
    test -f /etc/localembed/config.yaml && \
    test -f /usr/lib/systemd/system/localembed.service && \
    id localembed && \
    stat -c '%U:%G %a %n' /var/lib/localembed /var/lib/localembed/models /var/log/localembed

# 3. The systemd unit must be syntactically valid and enableable.
RUN echo "--- Verifying systemd unit ---" && \
    systemd-analyze verify /usr/lib/systemd/system/localembed.service

# 4. Boot test: the server must start and report a clear "no models" message
#    (the RPM ships no model; this proves the binary + config load correctly).
RUN echo "--- Boot Test ---" && \
    ONNX_PATH=/usr/lib64/localembed/libonnxruntime.so \
      mlcembedder -config /etc/localembed/config.yaml > /tmp/server.log 2>&1 & \
    sleep 3; \
    cat /tmp/server.log; \
    grep -q "Local Embedding Engine" /tmp/server.log || (echo "server did not boot" && exit 1)

# 5. Man pages must be shipped (check the files directly; the man index is not
#    built in this minimal image, so `man -w` would falsely fail).
RUN echo "--- Man Pages ---" && \
    test -f /usr/share/man/man1/mlcembedder.1.gz && \
    test -f /usr/share/man/man1/localembed-cli.1.gz && \
    echo "man pages present"

CMD ["/bin/bash"]
